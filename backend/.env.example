# Copy to backend/.env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Model and effort (defaults shown).
EVOLVE_MODEL=claude-opus-5-5
EVOLVE_EFFORT=medium
EVOLVE_QUESTIONS_EFFORT=low

# Live web research before drafting (true/false).
EVOLVE_RESEARCH=true
# Server-side refusal fallbacks beta (true/false).
EVOLVE_FALLBACKS=true

# Comma-separated allowed origins in production. Empty = any localhost port.
CORS_ORIGINS=
